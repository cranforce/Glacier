# Where the Snowforce app lives, and the role that owns it. Moving the app to a
# dedicated schema and role later means changing these and re-running deploy.sh.
APP_DB=CRM_DB
APP_SCHEMA=CMILLER_SF_PLAYGROUND
APP_ROLE=DS_DATA_ENGINEERING_ROLE
APP_WAREHOUSE=SNOWFORCE_WH

# The external access integration a Snowflake admin creates once
# (app/sql/20_admin_integration.sql).
APP_INTEGRATION=SNOWFORCE_SALESFORCE_EAI

# snow CLI connection used to deploy
SNOW_CONNECTION=ODBM
