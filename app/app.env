# Where the Glacier app lives, and the role that owns it. A Snowflake admin
# creates these once (app/deploy.sh admin-sql setup); deploy.sh fills them in.
APP_DB=GLACIER_DB
APP_SCHEMA=APP
APP_ROLE=GLACIER_APP_ROLE
APP_WAREHOUSE=GLACIER_WH

# The external access integration a Snowflake admin creates once
# (app/deploy.sh admin-sql integration).
APP_INTEGRATION=GLACIER_SALESFORCE_EAI

# snow CLI connection used to deploy
SNOW_CONNECTION=ODBM
