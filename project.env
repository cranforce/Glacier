# Project settings, sourced by run.sh. Anything already set in the environment
# wins, e.g.:  SNOW_WAREHOUSE=OTHER_WH ./run.sh
: "${SF_ORG:=odbm-npc-prod}"
: "${SNOW_CONNECTION:=ODBM}"
: "${SNOW_DB:=CRM_DB}"
: "${SNOW_SCHEMA:=CMILLER_SF_PLAYGROUND}"
: "${SNOW_ROLE:=DS_DATA_ENGINEERING_ROLE}"
: "${SNOW_WAREHOUSE:=DS_DATA_ENGINNNERING_WH}"

# What a sync does with records deleted in Salesforce (objects.conf can
# override this per object):
#   off     ignore deletes
#   flag    keep the row and set ISDELETED = TRUE
#   remove  delete the row from the Snowflake table
: "${DELETE_MODE:=flag}"

# Syncs see deletes through the Salesforce recycle bin, which keeps them for
# about 15 days (less if the bin fills up or is emptied). If an object hasn't
# synced in this many days, the sync also reconciles: it compares every Id in
# the table against Salesforce to catch deletes that have left the bin.
: "${RECONCILE_AFTER_DAYS:=14}"

export SF_ORG SNOW_CONNECTION SNOW_DB SNOW_SCHEMA SNOW_ROLE SNOW_WAREHOUSE DELETE_MODE RECONCILE_AFTER_DAYS
