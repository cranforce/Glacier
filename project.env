# Project settings, sourced by run.sh. Anything already set in the environment
# wins, e.g.:  SNOW_WAREHOUSE=OTHER_WH ./run.sh
: "${SF_ORG:=odbm-npc-prod}"
: "${SNOW_CONNECTION:=ODBM}"
: "${SNOW_DB:=CRM_DB}"
: "${SNOW_SCHEMA:=CMILLER_SF_PLAYGROUND}"
: "${SNOW_ROLE:=DS_DATA_ENGINEERING_ROLE}"
: "${SNOW_WAREHOUSE:=DS_DATA_ENGINNNERING_WH}"
export SF_ORG SNOW_CONNECTION SNOW_DB SNOW_SCHEMA SNOW_ROLE SNOW_WAREHOUSE
